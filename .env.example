# Copy to .env for local dev, or set these as Railway environment variables.
# NEVER commit an actual .env file with real values.

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
# Direct Postgres connection string (Project Settings → Database →
# Connection string) — different from SUPABASE_URL above. Needed for
# system backups (backup.ts uses pg_dump against this).
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres
# PORT is set automatically by Railway — no need to set it manually there.
PORT=3000
