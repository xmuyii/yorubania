# Copy to .env for local dev; set the same keys as build-time environment
# variables wherever you host the frontend (Vercel/Netlify/Railway static).
# These are all PUBLIC by nature (anon key, not service role) — safe to
# ship in a client bundle, unlike the backend's SUPABASE_SERVICE_ROLE_KEY.

VITE_API_BASE_URL=https://your-backend.up.railway.app/api
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
